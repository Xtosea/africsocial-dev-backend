{
"$schema": "node_modules/wrangler/config-schema.json",
"name": "africsocial-api",
"main": "worker/index.js",
"compatibility_date": "2026-08-15",
"compatibility_flags": [
"nodejs_compat"
],
"workers_dev": true,

"r2_buckets": [
{
"binding": "MEDIA_BUCKET",
"bucket_name": "africa"
}
],

"durable_objects": {
"bindings": [
{
"name": "SOCKET_ROOM",
"class_name": "SocketRoom"
}
]
},

"migrations": [
{
"tag": "v1",
"new_sqlite_classes": [
"SocketRoom"
]
}
],

"observability": {
"enabled": true,
"head_sampling_rate": 1,
"redact_query_string": false,

"logs": {
  "enabled": true,
  "head_sampling_rate": 1,
  "invocation_logs": true,
  "persist": true
},

"traces": {
  "enabled": true,
  "head_sampling_rate": 1,
  "persist": true
},

"issue_detection": {
  "enabled": true
}

}
}